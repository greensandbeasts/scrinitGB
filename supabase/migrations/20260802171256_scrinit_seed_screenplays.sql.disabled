/* Scrinit - Seed screenplays (auto-generated) */

insert into public.screenplays (id, writer_id, title, genre, logline, synopsis, content, page_count, status, cover_color, tags, published_at)
values (
  'e0000001-0000-0000-0000-000000000001',
  'a1111111-1111-1111-1111-111111111111',
  'The Lighthouse Keepers',
  'Thriller',
  'A lone lighthouse keeper on a remote island begins receiving radio distress calls from a ship that vanished forty years ago — and discovers the calls are coming from inside the tower.',
  'When Nora accepts a six-month posting at a decommissioned lighthouse on Skellig Island, she expects solitude, not a haunting. But on the third night, the long-dead radio crackles to life with a voice begging for help from a vessel lost in 1984. As the storms close in and the supply boat stops coming, Nora must determine whether she is losing her mind or uncovering something the sea has been trying to keep secret for decades.',
  $scrinit_json$[[{"t":"h","x":"INT. LIGHTHOUSE TOWER - NIGHT"},{"t":"a","x":"A narrow spiral of rusted iron stairs. Water drips somewhere in the dark. NORA VALE (34, weathered, practical) climbs with a flashlight clamped in her teeth, her breath fogging in the cold."},{"t":"a","x":"She reaches the lamp room. The great fresnel lens is dark, hasn’t turned in years. Glass panels are clouded with salt."},{"t":"a","x":"Nora sets down her pack. Looks out at the black Atlantic. Nothing for twenty miles in any direction."},{"t":"a","x":"She pulls the flashlight from her teeth."},{"t":"c","x":"NORA"},{"t":"d","x":"Six months. You can do six months."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. KEEPERS QUARTERS - LATER"},{"t":"a","x":"A cramped room below the tower. A cot, a wood stove, a shortwave radio bolted to the wall. Peeling maps of the Irish coast."},{"t":"a","x":"Nora unpacks methodically. Books. A photograph of a young girl, face down. Dried food. A journal with a few pages already written."},{"t":"a","x":"She opens the journal and writes: Day 1. Boiler works. Radio is garbage but I didn’t come here to talk to anyone. The supply boat comes every two weeks."},{"t":"a","x":"She pauses. Looks at the radio. Something about it — the way the dial needle twitches, just slightly, like something is trying to come through."},{"t":"a","x":"She turns it off. The needle settles."},{"t":"c","x":"NORA"},{"t":"d","x":"Nope."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"EXT. SKELLIG ISLAND - DAY"},{"t":"a","x":"A bare tooth of rock three hundred yards long. The lighthouse stands at the northern cliff. Gulls. Wind. Nothing else."},{"t":"a","x":"Nora walks the perimeter path, checking the sea wall. She pauses at a cairn of stones — old, weathered smooth. A tin plaque, illegible."},{"t":"a","x":"She scrapes at it with her thumb. Faint letters: LOST AT SEA 1984."},{"t":"a","x":"She stares at it a long moment. The wind pulls at her coat."},{"t":"c","x":"NORA"},{"t":"p","x":"(to herself)"},{"t":"d","x":"Forty years. And they still put up a rock."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. KEEPERS QUARTERS - NIGHT"},{"t":"a","x":"Day 3. Wind howls outside. Nora reads by lantern light. A book about lighthouse keepers. She’s annotated the margins heavily."},{"t":"a","x":"The radio is off. Has been for two days."},{"t":"a","x":"Then — static. A low crackle. The dial needle twitches."},{"t":"a","x":"Nora looks up. She didn’t touch it. The power switch is visibly in the OFF position."},{"t":"a","x":"The crackle builds. Through the noise, a voice — distant, breaking up, a man’s voice:"},{"t":"c","x":"RADIO VOICE"},{"t":"d","x":"...anyone receiving... this is the vessel Cormorant... position unknown... taking on water... please..."}],[{"t":"a","x":"Nora is on her feet. She grabs the mic."},{"t":"c","x":"NORA"},{"t":"d","x":"Cormorant, this is Skellig Light. Say again your position. Over."},{"t":"a","x":"Silence. Then the voice again, clearer now, desperate:"},{"t":"c","x":"RADIO VOICE"},{"t":"d","x":"...we can see your light... please turn it on... we’re coming in... we can see the light..."},{"t":"a","x":"Nora looks at the dead lamp above her. The tower. It hasn’t lit in years."},{"t":"c","x":"NORA"},{"t":"d","x":"The light is off. It’s been off for years. You can’t see it."},{"t":"a","x":"Long static. Then, very quietly:"},{"t":"c","x":"RADIO VOICE"},{"t":"d","x":"...then how are we here?"},{"t":"a","x":"The radio dies. Needle flat. Silence."},{"t":"a","x":"Nora stands in the dark, the mic still in her hand. Her breath is rapid."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. KEEPERS QUARTERS - DAWN"},{"t":"a","x":"Grey light. Nora hasn’t slept. The journal is open. She’s written the same phrase over and over: The Cormorant. 1984."},{"t":"a","x":"She pulls out the keeper’s book — a leather-bound log going back decades. She flips to 1984. The handwriting changes. A different keeper — THOMAS REED."},{"t":"a","x":"She reads aloud, tracing the lines:"},{"t":"c","x":"NORA"},{"t":"d","x":"October 17th. Storm. The Cormorant went on the rocks west of the skellig. Three souls aboard. I lit the lamp but the fog was too thick. They never saw it. I heard them on the radio for three days after. Then nothing."},{"t":"a","x":"She turns the page."},{"t":"c","x":"NORA"},{"t":"d","x":"October 20th. The voices stopped. Thank God. I can’t light that lamp again. Every time I do, they think we’re calling them in."},{"t":"a","x":"Nora closes the book slowly."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. LAMP ROOM - NIGHT"},{"t":"a","x":"Wind and rain hammer the glass. Nora stands before the fresnel lens, a hand on the manual crank."},{"t":"a","x":"She looks down at the keeper’s log, open on the floor. Thomas Reed’s last entry: I left the light off for twenty years. They still come on the radio every October. I think they’ll keep coming until someone turns it on and guides them in. Or until someone tells them to stop."},{"t":"a","x":"Nora looks out at the storm. Lightning. Black waves on the rocks below."},{"t":"a","x":"The radio crackles again from downstairs. The voice — closer, louder, the same words:"},{"t":"c","x":"RADIO VOICE"},{"t":"d","x":"...we can see your light... we’re coming in..."}],[{"t":"a","x":"Nora puts both hands on the crank. She could light it. Guide them in. End it."},{"t":"a","x":"Or she could go downstairs and tell them to stop. Let them go."},{"t":"a","x":"She stares at the lens. Rain streaks the glass."},{"t":"a","x":"Her hands tremble on the crank."},{"t":"c","x":"NORA"},{"t":"p","x":"(barely audible)"},{"t":"d","x":"I’m not Thomas. I’m not going to leave you out there for forty years."},{"t":"a","x":"She cranks the mechanism. With a groan of old brass, the lens begins to turn."},{"t":"a","x":"She throws the power switch. The lamp ignites — a blinding white beam sweeping out over the black water, cutting through the rain."},{"t":"a","x":"Downstairs, the radio goes silent."},{"t":"a","x":"Nora watches the beam rotate. Out in the dark, for just a moment, she sees — or thinks she sees — three faint lights on the water. Moving toward the shore."},{"t":"a","x":"Then they’re gone. The sea is empty."},{"t":"a","x":"The radio stays silent."},{"t":"a","x":"Nora exhales. Her hands stop shaking."},{"t":"c","x":"NORA"},{"t":"d","x":"Come home."},{"t":"t","x":"FADE OUT."}]]$scrinit_json$::jsonb,
  8,
  'published',
  'amber',
  array['contained', 'psychological', 'isolated setting', 'female lead'], now() - interval '14 days'
)
on conflict (id) do nothing;

insert into public.screenplays (id, writer_id, title, genre, logline, synopsis, content, page_count, status, cover_color, tags, published_at)
values (
  'e0000002-0000-0000-0000-000000000002',
  'a1111111-1111-1111-1111-111111111111',
  'Saltwater',
  'Drama',
  'An estranged daughter returns to her dying father’s coastal home to settle his affairs and discovers a lifetime of letters he wrote to her but never sent.',
  'Maya has not spoken to her father in twelve years. When she returns to the house where she grew up to help him die, she finds a box of letters — one for every week since she left. Each begins the same way: Dear Maya, today the sea was... As she reads through years of tides and weather and small observations, Maya begins to see the man she refused to know and the distance that was never as wide as she thought.',
  $scrinit_json$[[{"t":"h","x":"EXT. COASTAL HOUSE - DAY"},{"t":"a","x":"A weathered cottage on a bluff above the sea. Paint peeling. A garden gone wild. A hospice van pulls away."},{"t":"a","x":"MAYA TORRES (31, guarded, city-tired) sits in her parked car, staring at the house. She doesn’t move to get out."},{"t":"a","x":"A HOSPICE NURSE (50s, kind) exits the front door, sees Maya, approaches."},{"t":"c","x":"NURSE"},{"t":"d","x":"You must be Maya. I’m Ruth. He’s been asking."},{"t":"c","x":"MAYA"},{"t":"d","x":"How is he?"},{"t":"c","x":"NURSE"},{"t":"d","x":"He’s tired. The morphine makes him foggy by afternoon. Mornings are better."},{"t":"a","x":"Maya nods. Still doesn’t move."},{"t":"c","x":"NURSE"},{"t":"p","x":"(gently)"},{"t":"d","x":"He won’t bite. He’s too tired to bite."},{"t":"a","x":"Maya almost smiles. She opens the car door."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. COASTAL HOUSE - BEDROOM - CONTINUOUS"},{"t":"a","x":"A small room. Medical equipment beside a single bed. The curtains are open to the sea."},{"t":"a","x":"HENRY TORRES (68, thin, yellowed) lies propped on pillows. His eyes are open but distant. The room smells of salt and lavender."},{"t":"a","x":"Maya stands in the doorway. Henry turns his head. A long beat."},{"t":"c","x":"HENRY"},{"t":"p","x":"(hoarse)"},{"t":"d","x":"You came."},{"t":"c","x":"MAYA"},{"t":"d","x":"Ruth called."},{"t":"a","x":"Henry nods slowly. He looks past her, at the doorway, like he expected someone else to be standing there too."},{"t":"c","x":"HENRY"},{"t":"d","x":"Your mother used to stand right there. Same look on her face. Like the house owed her something."},{"t":"a","x":"Maya’s jaw tightens."},{"t":"c","x":"MAYA"},{"t":"d","x":"I’m not here to talk about her."},{"t":"c","x":"HENRY"},{"t":"d","x":"No. I suppose not."},{"t":"a","x":"Silence. The sea outside."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. COASTAL HOUSE - STUDY - LATER"},{"t":"a","x":"Maya goes through drawers. Bills. Medical records. A house that has been slowly dying along with its owner."},{"t":"a","x":"She opens a closet. A cardboard box falls. Letters spill across the floor — dozens, hundreds. White envelopes, all sealed, all addressed in the same careful hand: Maya Torres — at various addresses. Her college dorm. Her first apartment. Her current one. None of them have postmarks. None were sent."},{"t":"a","x":"Maya kneels among them. Picks one up. Turns it over. Opens it."},{"t":"a","x":"INSERT — the letter."}],[{"t":"a","x":"Dear Maya, today the sea was glass. I saw a whale spout past the buoy, the first one this season. I thought you’d want to know. I don’t know why I keep writing these. I don’t know where I’d send them even if I could. But the days are long and the house is quiet and writing to you is the closest thing I have to talking to you."},{"t":"a","x":"Maya’s hand is shaking. She sets the letter down. Picks up another."},{"t":"a","x":"Dear Maya, today the sea was rough. The fence blew down again. I fixed it. You always hated when I let things go. I’m letting a lot go now. The garden especially. I think you’d be appalled."},{"t":"a","x":"She almost laughs. Almost."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"EXT. COASTAL BLUFF - DUSK"},{"t":"a","x":"Maya sits on the bluff with a stack of letters. The sea is amber in the last light. She reads."},{"t":"a","x":"VOICEOVER — Henry’s voice, warm, the way he might have been if things were different:"},{"t":"c","x":"HENRY (V.O.)"},{"t":"d","x":"Dear Maya, today the sea was flat and grey and I thought about the day I taught you to swim. You were five. You refused to get in. You stood at the edge of the water for an hour. I didn’t push you. I just waited. And then you walked in on your own, all at once, like you’d decided something. You were always like that. You decided things all at once."},{"t":"a","x":"Maya closes her eyes."},{"t":"c","x":"HENRY (V.O.)"},{"t":"d","x":"I should have waited with you more. Instead of pushing. I’m sorry."},{"t":"a","x":"She opens her eyes. Looks at the water."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. COASTAL HOUSE - BEDROOM - MORNING"},{"t":"a","x":"Henry is awake. Clearer today. Maya sits beside the bed with tea. Between them, an awkward peace."},{"t":"c","x":"MAYA"},{"t":"d","x":"I found the letters."},{"t":"a","x":"Henry’s face shifts. Something like embarrassment. Something like relief."},{"t":"c","x":"HENRY"},{"t":"d","x":"I didn’t know how to send them. I didn’t know if you’d read them."},{"t":"c","x":"MAYA"},{"t":"d","x":"I would have."},{"t":"c","x":"HENRY"},{"t":"d","x":"You’re here now."},{"t":"a","x":"A beat. Maya takes his hand. The first touch in twelve years. His fingers are cold."},{"t":"c","x":"MAYA"},{"t":"d","x":"I’m here now."},{"t":"a","x":"They sit together. Outside, the sea moves. The curtains breathe."},{"t":"t","x":"FADE OUT."}]]$scrinit_json$::jsonb,
  6,
  'published',
  'sky',
  array['family', 'grief', 'reconciliation', 'epistolary'], now() - interval '7 days'
)
on conflict (id) do nothing;

insert into public.screenplays (id, writer_id, title, genre, logline, synopsis, content, page_count, status, cover_color, tags, published_at)
values (
  'e0000003-0000-0000-0000-000000000003',
  'a5555555-5555-5555-5555-555555555555',
  'The Weight of Light',
  'Science Fiction',
  'A xenolinguist on a generation ship receives a message from the colony they are traveling toward — but it is written in a language that has not been invented yet, by someone who is not born yet.',
  'The generation ship Aurora is 180 years from Earth, 60 years from Kepler-442b. Dr. Adaeze Nwosu has spent her career decoding alien signals that turned out to be cosmic noise. Then the colony beacon answers — not with a welcome, but with a transmission in a language that should not exist, describing events that have not happened, from a future colony that may be warning them not to come.',
  $scrinit_json$[[{"t":"h","x":"INT. AURORA - LAB MODULE - NIGHT SHIFTCYCLE"},{"t":"a","x":"A cramped lab cluttered with monitors and linguistic diagrams. The ship hums. Through a narrow viewport: stars, unmoving, eternal."},{"t":"a","x":"DR. ADAEZE NWOSU (40, sharp-eyed, exhausted) sits before a waveform display. Headphones on. She’s been listening to the same loop for hours."},{"t":"a","x":"The signal from Kepler-442b. The colony beacon — the one that’s been silent for sixty years — suddenly active. A response to their approach."},{"t":"a","x":"She removes the headphones. Rubs her temples. Speaks to the ship’s AI:"},{"t":"c","x":"ADAEZE"},{"t":"d","x":"Helios, run structural analysis on the signal. Syntax tree, semantic density, repetition index."},{"t":"c","x":"HELIOS (O.S.)"},{"t":"d","x":"Running. Preliminary results: the signal contains recursive grammatical structures with no analog in Earth language databases. Estimated semantic density: four times higher than Mandarin Chinese."},{"t":"a","x":"Adaeze frowns."},{"t":"c","x":"ADAEZE"},{"t":"d","x":"Four times. That’s not a greeting."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. AURORA - COMMAND MODULE - LATER"},{"t":"a","x":"CAPTAIN IRINA VOLKOV (55, practical, weathered by decades in transit) reviews the analysis. Through the main viewport, the star field."},{"t":"a","x":"Adaeze stands across from her, intense."},{"t":"c","x":"IRINA"},{"t":"d","x":"So the colony is alive. That’s good news."},{"t":"c","x":"ADAEZE"},{"t":"d","x":"The colony is alive. But they’re not saying hello. I’ve decoded fragments. Irina, they’re describing a geological event. A tectonic collapse. Cities sinking."},{"t":"c","x":"IRINA"},{"t":"d","x":"That happened? On the colony?"},{"t":"c","x":"ADAEZE"},{"t":"d","x":"That’s the problem. The colony wasn’t founded. The ship that was supposed to found it arrives twenty years after us. We’re the second wave. Nobody’s down there yet."},{"t":"a","x":"Irina stares at her."},{"t":"c","x":"IRINA"},{"t":"d","x":"Then who’s sending the message?"},{"t":"a","x":"Adaeze has no answer. The signal loops again, filling the room with its strange, layered music."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. AURORA - LAB MODULE - LATER"},{"t":"a","x":"Adaeze works through the night. Diagrams cover every surface. She’s found a pattern — the signal contains temporal markers. Past, present, and future tenses, but used in ways that suggest the speaker experiences them simultaneously."},{"t":"a","x":"She transcribes a decoded fragment. Reads it aloud:"},{"t":"c","x":"ADAEZE"},{"t":"d","x":"The ground will have remembered what we built. We are writing from the foundation that is falling. You will arrive and we will have already warned you. The choice is the same in every tense: do not build on the southern shelf."}],[{"t":"a","x":"She stares at the words. Picks up her comm."},{"t":"c","x":"ADAEZE"},{"t":"d","x":"Irina. The message isn’t a greeting. It’s a warning. From people who are there. Who will be there. They’re telling us where not to build the colony."},{"t":"c","x":"IRINA (V.O.)"},{"t":"d","x":"People who will be there? Adaeze, that’s not how time works."},{"t":"a","x":"Adaeze looks at the viewport. The stars haven’t moved. They never move, not on a generation ship. Sixty years to go."},{"t":"c","x":"ADAEZE"},{"t":"d","x":"Maybe it isn’t. But if there’s a chance this is real, we have sixty years to listen. And they have sixty years to tell us what they know."},{"t":"a","x":"She puts down the comm. Puts her headphones back on. Closes her eyes."},{"t":"a","x":"The signal plays. Layered. Patient. Like someone speaking from a place where time is just another direction."},{"t":"t","x":"FADE OUT."}]]$scrinit_json$::jsonb,
  4,
  'published',
  'emerald',
  array['generation ship', 'linguistics', 'time', 'first contact'], now() - interval '21 days'
)
on conflict (id) do nothing;

insert into public.screenplays (id, writer_id, title, genre, logline, synopsis, content, page_count, status, cover_color, tags, published_at)
values (
  'e0000004-0000-0000-0000-000000000004',
  'a5555555-5555-5555-5555-555555555555',
  'After the Fire',
  'Drama',
  'Three siblings return to their childhood home after a wildfire destroys their town and must decide what to save from a father’s legacy they each remember differently.',
  'The Aldridge siblings have not been in the same room since their mother’s funeral. When a wildfire sweeps through their Northern California hometown, they return to find the house standing but scorched, their father’s woodshop destroyed, and a half-finished piece of furniture that tells a different story about the man who raised them. Over three days, they sort through ash and memory, fighting over what to keep, what to let go, and who their father really was.',
  $scrinit_json$[[{"t":"h","x":"EXT. ALDRIDGE HOUSE - DAY"},{"t":"a","x":"A farmhouse at the edge of a burned forest. The trees are black sticks. The house survived — barely. One wall is charred. The yard is covered in ash, like grey snow."},{"t":"a","x":"A truck pulls up. CALEB ALDRIDGE (38, the eldest, steady, resentful) gets out. He surveys the damage with a flat expression."},{"t":"a","x":"A second car. JUNE ALDRIDGE (34, restless, lives far away) steps out, coughing at the smoke still hanging in the air."},{"t":"a","x":"A third vehicle — a motorcycle. SAM ALDRIDGE (29, the youngest, angry in a way that has calcified into personality) kills the engine."},{"t":"a","x":"The three siblings stand in the ash, looking at the house. None of them move toward it."},{"t":"c","x":"CALEB"},{"t":"d","x":"Structural’s okay. I checked with the county."},{"t":"c","x":"JUNE"},{"t":"d","x":"The shop’s gone."},{"t":"a","x":"They all look to the side of the house. Where a woodshop stood, now: a black foundation, twisted metal, and a chimney of bricks still standing."},{"t":"c","x":"SAM"},{"t":"d","x":"Good."},{"t":"a","x":"Caleb and June look at him. He doesn’t elaborate."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. ALDRIDGE HOUSE - DAY"},{"t":"a","x":"Inside, smoke damage. Everything is grey. Sheets over furniture. The smell is overwhelming."},{"t":"a","x":"Caleb opens windows. June covers her nose. Sam walks through the house like he’s cataloging everything wrong with it."},{"t":"c","x":"JUNE"},{"t":"d","x":"We need to sort the salvageable stuff. Insurance wants an inventory by Friday."},{"t":"c","x":"CALEB"},{"t":"d","x":"I’ll handle the inventory. You two can go back to your lives."},{"t":"c","x":"SAM"},{"t":"d","x":"Generous."},{"t":"c","x":"CALEB"},{"t":"d","x":"I’ve been handling things for five years, Sam. While you were — where were you?"},{"t":"c","x":"SAM"},{"t":"d","x":"Don’t."},{"t":"a","x":"June steps between them. Physically. The same gesture their mother used to make."},{"t":"c","x":"JUNE"},{"t":"d","x":"Three days. We sort the house in three days and we go. Nobody has to be happy about it."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"EXT. WOODSHOP FOUNDATION - DUSK"},{"t":"a","x":"Sam stands in the ruins of the shop. He kicks through debris with his boot. Finds something. Pulls it from the ash."},{"t":"a","x":"A piece of wood. Half-finished. A table leg, carved with a pattern — vines and leaves, intricate. The work of someone who cared."},{"t":"a","x":"Sam turns it over in his hands. His face changes. The anger cracks, just for a moment, and something else shows through."},{"t":"a","x":"June appears behind him. Sees what he’s holding."},{"t":"c","x":"JUNE"},{"t":"d","x":"He was still making things."},{"t":"c","x":"SAM"},{"t":"p","x":"(quietly)"},{"t":"d","x":"I thought he’d stopped. He told me he’d stopped."},{"t":"a","x":"June sits beside him on the foundation wall."},{"t":"c","x":"JUNE"},{"t":"d","x":"He told all of us different things. That was his gift."},{"t":"a","x":"Sam laughs — short, sad."},{"t":"c","x":"SAM"},{"t":"d","x":"Some gift."},{"t":"t","x":"CUT TO:"}],[{"t":"h","x":"INT. ALDRIDGE HOUSE - NIGHT"},{"t":"a","x":"The three siblings sit in the kitchen. The table is cleared. Between them: a bottle of whiskey, three glasses, and the carved table leg."},{"t":"a","x":"Caleb pours. They drink. The house creaks around them."},{"t":"c","x":"CALEB"},{"t":"d","x":"He called me the week before. I didn’t pick up."},{"t":"a","x":"June and Sam look at him. Caleb has never admitted to missing a call from their father."},{"t":"c","x":"JUNE"},{"t":"d","x":"What did he want?"},{"t":"c","x":"CALEB"},{"t":"d","x":"To tell me about the table. He was making a table. For the house. He wanted me to see it before —"},{"t":"a","x":"He stops. Drinks."},{"t":"c","x":"SAM"},{"t":"d","x":"Before what?"},{"t":"c","x":"CALEB"},{"t":"d","x":"Before he couldn’t make things anymore. The doctor said his hands were going. Arthritis. He wanted to finish one last piece."},{"t":"a","x":"Sam looks at the table leg. The carved vines. His father’s hands, which he remembers as brutal, making something delicate."},{"t":"c","x":"SAM"},{"t":"d","x":"We should finish it."},{"t":"a","x":"Caleb and June stare at him."},{"t":"c","x":"SAM"},{"t":"d","x":"The table. We have the leg. We have three days. We should finish it."},{"t":"a","x":"A long silence. The house settles. Outside, ash falls like the first snow of a season none of them expected to see here."},{"t":"c","x":"JUNE"},{"t":"d","x":"Okay."},{"t":"c","x":"CALEB"},{"t":"p","x":"(after a moment)"},{"t":"d","x":"Okay."},{"t":"t","x":"FADE OUT."}]]$scrinit_json$::jsonb,
  5,
  'published',
  'rose',
  array['family', 'grief', 'wildfire', 'siblings', 'memory'], now() - interval '10 days'
)
on conflict (id) do nothing;

insert into public.screenplays (id, writer_id, title, genre, logline, synopsis, content, page_count, status, cover_color, tags)
values (
  'e0000005-0000-0000-0000-000000000005',
  'a1111111-1111-1111-1111-111111111111',
  'The Hollow Hour',
  'Horror',
  'A night-shift radio host discovers that every caller during the 3AM hour is describing the same nightmare — and they are all calling from the same town.',
  'Vee Delacroix hosts the graveyard shift at a small-town radio station. Night after night, the 3AM callers share eerily similar dreams of a door in a field. When she traces the calls, she realizes they are all from Meridian, a town that was evacuated and demolished twenty years ago.',
  $scrinit_json$[[{"t":"h","x":"INT. RADIO STATION - NIGHT"},{"t":"a","x":"A small studio. Foam walls. A single microphone. VEE DELACROIX (29, insomnia-eyed, voice like smoke) leans into the mic."},{"t":"c","x":"VEE"},{"t":"d","x":"You’re listening to Night Watch on KQRT. The hour where anything goes. I’m Vee. What’s keeping you up?"},{"t":"a","x":"The board lights up. She takes a call."},{"t":"c","x":"CALLER 1 (V.O.)"},{"t":"d","x":"I keep having the same dream. There’s a door in a field. Just a door. No building. And I know I have to open it but my hand won’t move."},{"t":"t","x":"CUT TO:"}]]$scrinit_json$::jsonb,
  1,
  'draft',
  'slate',
  array['horror', 'radio', 'dreams', 'small town']
)
on conflict (id) do nothing;
