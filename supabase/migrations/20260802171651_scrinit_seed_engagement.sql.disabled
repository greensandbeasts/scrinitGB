-- ──────────────────────────────────────────────────────────────────────────
-- Reader feedback
-- ──────────────────────────────────────────────────────────────────────────
-- Lighthouse Keepers (4 completions)
insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000001-0000-0000-0000-000000000001', 'e0000001-0000-0000-0000-000000000001', 'b2222222-2222-2222-2222-222222222222', true, 9, 9, 8, 8, 9, 'Genuinely unsettling. The radio scenes gave me chills — the moment when the voice asks "then how are we here?" is the kind of hook that stays with you. Nora is a compelling protagonist, practical and smart, which makes her fear more earned. The ending is ambiguous in the best way.', 'completed'),
('a1000001-0000-0000-0000-000000000002', 'e0000001-0000-0000-0000-000000000001', 'b3333333-3333-3333-3333-333333333331', true, 8, 8, 8, 7, 8, 'Tense and atmospheric. The isolation feels real. I wanted a bit more about Thomas Reed — the flashback entries are the strongest material. The ending pays off beautifully though. Came back to finish it the next day.', 'completed'),
('a1000001-0000-0000-0000-000000000003', 'e0000001-0000-0000-0000-000000000001', 'b3333333-3333-3333-3333-333333333332', true, 9, 9, 9, 8, 8, 'This is why I read scripts. The concept is simple but the execution is sharp. Every scene earns its place. The dialogue between Nora and the radio voice is hypnotic. I would watch this in a theater.', 'completed'),
('a1000001-0000-0000-0000-000000000004', 'e0000001-0000-0000-0000-000000000001', 'b3333333-3333-3333-3333-333333333333', true, 8, 8, 7, 8, 9, 'The dialogue crackles. The setup is slow but deliberate — by page 4 I was hooked. The final scene in the lamp room is cinematic and moving. A contained thriller that actually delivers on its premise.', 'completed')
on conflict (assignment_id) do nothing;

-- Saltwater (3 completions)
insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000002-0000-0000-0000-000000000001', 'e0000002-0000-0000-0000-000000000002', 'b2222222-2222-2222-2222-222222222222', true, 8, 8, 9, 7, 8, 'Emotionally devastating in a quiet way. The letters device could have been manipulative but it earns every beat. Henry and Maya feel like real people. The swimming memory broke me a little.', 'completed'),
('a1000002-0000-0000-0000-000000000002', 'e0000002-0000-0000-0000-000000000002', 'b3333333-3333-3333-3333-333333333331', false, 6, 7, 8, 5, 7, 'Beautifully written but slow. The first two pages are setup with no tension. The letters are lovely but I wanted more conflict. The performances would carry this. Not sure it is a feature — maybe a short?', 'completed'),
('a1000002-0000-0000-0000-000000000003', 'e0000002-0000-0000-0000-000000000002', 'b3333333-3333-3333-3333-333333333332', true, 8, 7, 9, 7, 8, 'A small story told with enormous care. The relationship between father and daughter is rendered without sentimentality. The ending is perfect — simple, devastating. This is the kind of script that gets under your skin.', 'completed')
on conflict (assignment_id) do nothing;

-- Weight of Light (2 completions)
insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000003-0000-0000-0000-000000000001', 'e0000003-0000-0000-0000-000000000003', 'b2222222-2222-2222-2222-222222222222', true, 9, 9, 8, 8, 9, 'Ambitious and intelligent. The linguistic puzzle is genuinely fascinating — the idea of a language that treats time non-linearly is the kind of sci-fi concept that lingers. Adaeze is a great protagonist. Needs a bigger budget but the writing is prestige-tier.', 'completed'),
('a1000003-0000-0000-0000-000000000002', 'e0000003-0000-0000-0000-000000000003', 'b3333333-3333-3333-3333-333333333331', true, 8, 9, 7, 7, 8, 'The concept alone is worth the read. The execution is strong but the middle section gets dense with exposition. The ending is haunting. I would want to see the temporal language visualized on screen — that could be extraordinary.', 'completed')
on conflict (assignment_id) do nothing;

-- After the Fire (3 completions)
insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000004-0000-0000-0000-000000000001', 'e0000004-0000-0000-0000-000000000004', 'b3333333-3333-3333-3333-333333333331', true, 8, 8, 9, 7, 8, 'The sibling dynamic is the heart of this. Caleb, June, and Sam feel like a real family with real history. The table leg as a symbol of the father they each remember differently is elegant. The ending is warm without being saccharine.', 'completed'),
('a1000004-0000-0000-0000-000000000002', 'e0000004-0000-0000-0000-000000000004', 'b3333333-3333-3333-3333-333333333332', true, 9, 8, 9, 8, 9, 'This wrecked me. The scene where Sam finds the carved table leg is the emotional core — the way his anger cracks. The dialogue is natural and sharp. Three distinct voices that sound like siblings. This is a writer who knows people.', 'completed'),
('a1000004-0000-0000-0000-000000000003', 'e0000004-0000-0000-0000-000000000004', 'b3333333-3333-3333-3333-333333333333', true, 8, 8, 8, 8, 8, 'Grounded and deeply human. The wildfire is backdrop, not spectacle, which is the right choice. The three-day structure gives it a natural rhythm. The ending — three siblings deciding to build something together — is quietly powerful.', 'completed')
on conflict (assignment_id) do nothing;

-- ──────────────────────────────────────────────────────────────────────────
-- Industry request (Sofia Reyes requests The Lighthouse Keepers)
-- ──────────────────────────────────────────────────────────────────────────
insert into public.industry_requests (id, screenplay_id, industry_user_id, writer_id, status, message, company_snapshot, created_at, responded_at) values
('d1000001-0000-0000-0000-000000000001',
 'e0000001-0000-0000-0000-000000000001',
 'c3333333-3333-3333-3333-333333333333',
 'a1111111-1111-1111-1111-111111111111',
 'pending',
 'The engagement data on this is remarkable — 80% completion with strong recommendation rates. The contained thriller space is exactly what we are looking for. I would love to read the full script and discuss representation.',
 'Northbound Pictures',
 now() - interval '2 days', null)
on conflict (screenplay_id, industry_user_id) do nothing;
