update public.profiles set display_name = 'Marcus Cole', role = 'reader', avatar_color = 'sky' where email = 'reader@scrinit.demo';
update public.profiles set display_name = 'Reader Two', role = 'reader', avatar_color = 'sky' where email = 'reader2@scrinit.demo';
update public.profiles set display_name = 'Reader Three', role = 'reader', avatar_color = 'sky' where email = 'reader3@scrinit.demo';
update public.profiles set display_name = 'Reader Four', role = 'reader', avatar_color = 'sky' where email = 'reader4@scrinit.demo';
update public.profiles set display_name = 'Reader Five', role = 'reader', avatar_color = 'sky' where email = 'reader5@scrinit.demo';
update public.profiles set display_name = 'Reader Six', role = 'reader', avatar_color = 'sky' where email = 'reader6@scrinit.demo';
update public.profiles set display_name = 'Sofia Reyes', role = 'industry', company = 'Northbound Pictures', bio = 'Development executive focused on elevated genre and prestige limited series.', avatar_color = 'emerald' where email = 'industry@scrinit.demo';
