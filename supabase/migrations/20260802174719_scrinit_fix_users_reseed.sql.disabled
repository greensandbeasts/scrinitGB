-- ──────────────────────────────────────────────────────────────────────────
-- Reader feedback
-- ──────────────────────────────────────────────────────────────────────────
insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000001-0000-0000-0000-000000000001', 'e0000001-0000-0000-0000-000000000001', 'ec76b55b-08be-46a8-a323-edc1f0990f7a', true, 9, 9, 8, 8, 9, 'Genuinely unsettling. The radio scenes gave me chills. The ending is ambiguous in the best way.', 'completed'),
('a1000001-0000-0000-0000-000000000002', 'e0000001-0000-0000-0000-000000000001', '71e646ad-e06f-4aa5-a9e5-19d236523633', true, 8, 8, 8, 7, 8, 'Tense and atmospheric. The isolation feels real. The ending pays off beautifully.', 'completed'),
('a1000001-0000-0000-0000-000000000003', 'e0000001-0000-0000-0000-000000000001', '094fc2db-659b-493b-96f5-fc8249b06549', true, 9, 9, 9, 8, 8, 'This is why I read scripts. The concept is simple but the execution is sharp.', 'completed'),
('a1000001-0000-0000-0000-000000000004', 'e0000001-0000-0000-0000-000000000001', '0086fa7c-3d73-4a32-907d-f8991f0af319', true, 8, 8, 7, 8, 9, 'The dialogue crackles. A contained thriller that actually delivers on its premise.', 'completed')
on conflict (assignment_id) do nothing;

insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000002-0000-0000-0000-000000000001', 'e0000002-0000-0000-0000-000000000002', 'ec76b55b-08be-46a8-a323-edc1f0990f7a', true, 8, 8, 9, 7, 8, 'Emotionally devastating in a quiet way. The swimming memory broke me a little.', 'completed'),
('a1000002-0000-0000-0000-000000000002', 'e0000002-0000-0000-0000-000000000002', '71e646ad-e06f-4aa5-a9e5-19d236523633', false, 6, 7, 8, 5, 7, 'Beautifully written but slow. The first two pages are setup with no tension.', 'completed'),
('a1000002-0000-0000-0000-000000000003', 'e0000002-0000-0000-0000-000000000002', '094fc2db-659b-493b-96f5-fc8249b06549', true, 8, 7, 9, 7, 8, 'A small story told with enormous care. The ending is perfect.', 'completed')
on conflict (assignment_id) do nothing;

insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000003-0000-0000-0000-000000000001', 'e0000003-0000-0000-0000-000000000003', 'ec76b55b-08be-46a8-a323-edc1f0990f7a', true, 9, 9, 8, 8, 9, 'Ambitious and intelligent. The linguistic puzzle is genuinely fascinating.', 'completed'),
('a1000003-0000-0000-0000-000000000002', 'e0000003-0000-0000-0000-000000000003', '71e646ad-e06f-4aa5-a9e5-19d236523633', true, 8, 9, 7, 7, 8, 'The concept alone is worth the read. The ending is haunting.', 'completed')
on conflict (assignment_id) do nothing;

insert into public.reader_feedback (assignment_id, screenplay_id, reader_id, would_recommend, overall_rating, story_rating, characters_rating, pacing_rating, dialogue_rating, written_feedback, completion_status) values
('a1000004-0000-0000-0000-000000000001', 'e0000004-0000-0000-0000-000000000004', '71e646ad-e06f-4aa5-a9e5-19d236523633', true, 8, 8, 9, 7, 8, 'The sibling dynamic is the heart of this. The table leg as a symbol is elegant.', 'completed'),
('a1000004-0000-0000-0000-000000000002', 'e0000004-0000-0000-0000-000000000004', '094fc2db-659b-493b-96f5-fc8249b06549', true, 9, 8, 9, 8, 9, 'This wrecked me. The scene where Sam finds the carved table leg is the emotional core.', 'completed'),
('a1000004-0000-0000-0000-000000000003', 'e0000004-0000-0000-0000-000000000004', '0086fa7c-3d73-4a32-907d-f8991f0af319', true, 8, 8, 8, 8, 8, 'Grounded and deeply human. The ending is quietly powerful.', 'completed')
on conflict (assignment_id) do nothing;

