-- Assignments: Lighthouse Keepers (5 readers)
insert into public.assignments (id, screenplay_id, reader_id, status, reader_number, assigned_at, started_at, completed_at) values
('a1000001-0000-0000-0000-000000000001', 'e0000001-0000-0000-0000-000000000001', 'ec76b55b-08be-46a8-a323-edc1f0990f7a', 'completed', 1, now() - interval '12 days', now() - interval '12 days', now() - interval '11 days'),
('a1000001-0000-0000-0000-000000000002', 'e0000001-0000-0000-0000-000000000001', '71e646ad-e06f-4aa5-a9e5-19d236523633', 'completed', 2, now() - interval '11 days', now() - interval '11 days', now() - interval '10 days'),
